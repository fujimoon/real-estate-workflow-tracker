# real-estate-workflow-tracker の環境変数サンプル
# cp .env.sample .env して値を設定してください。
# ※ 本アプリは LLM を呼ばないため、APIキーは一切不要です。

# SQLite の保存先(既定: storage/tracker.db)
# TRACKER_DB_PATH="storage/tracker.db"

# 独自トレースIDの接頭辞(既定: WFT)
# TRACKER_ID_PREFIX="WFT"

# タイムライン表示に使うタイムゾーン(既定: Asia/Tokyo)
# TRACKER_TIMEZONE="Asia/Tokyo"

# ログレベル (DEBUG / INFO / WARNING / ERROR / CRITICAL)
LOG_LEVEL="INFO"

# --- 業務アプリ側(クライアント)が参照する設定 ---
# トラッカーのエンドポイント。未設定ならクライアントは記録を諦めて警告のみ出す
TRACKER_BASE_URL="http://localhost:8010"
# トラッカーへの送信タイムアウト(秒)。業務処理を止めないため短く保つ
TRACKER_TIMEOUT_SECONDS="2.0"
